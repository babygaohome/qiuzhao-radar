/* 秋招雷达 · 全局样式。颜色都走变量，深色模式在下面的媒体查询里改变量。 */
page {
  --bg: #F5F7FB; --surface: #FFFFFF; --sunk: #F0F3F9; --ink: #17243B; --muted: #61718A; --line: #E2E8F1;
  --accent: #3156D3; --accent2: #5574E3; --accent-ink: #FFFFFF; --accent-soft: #EBF0FF;
  --grad: linear-gradient(130deg, #203C85 0%, #3E5CCB 72%, #5670DD 100%);
  --shadow: 0 8rpx 28rpx rgba(27, 46, 86, .055);
  --ok: #16A05A; --warn: #D9820B; --bad: #E5484D; --off: #9AA3B2; --violet: #7A5AF8; --slate: #4B6479;
  --mono: "SF Mono", Menlo, "Roboto Mono", monospace;
  background: var(--bg);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}
@media (prefers-color-scheme: dark) {
  page {
    --bg: #0D1421; --surface: #162133; --sunk: #1D2A3E; --ink: #EBF1FA; --muted: #A2AEC0; --line: #2B3B52;
    --accent: #8AA9FF; --accent2: #A7B7FF; --accent-ink: #0D1421; --accent-soft: rgba(138, 169, 255, .16);
    --grad: linear-gradient(130deg, #233B78 0%, #3A57AD 100%);
    --shadow: 0 0 0 1rpx #2B3B52;
    --ok: #4CC486; --warn: #F0A93E; --bad: #FF7B70; --off: #6E7883; --violet: #B39BFF; --slate: #8FA9C0;
  }
}

.wrap { padding: 24rpx 32rpx 64rpx; box-sizing: border-box; }
.muted { color: var(--muted); }
.small { font-size: 24rpx; }
.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }

/* 概览数字 */
.stats { display: flex; background: var(--surface); border: 1rpx solid var(--line); border-radius: 24rpx; box-shadow: var(--shadow); overflow: hidden; }
.stat { flex: 1; padding: 24rpx 18rpx 20rpx; text-align: center; }
.stat .num { display: block; font-family: var(--mono); font-size: 42rpx; font-weight: 700; line-height: 1.2; color: var(--accent); }
.stat .lab { font-size: 22rpx; color: var(--muted); }
.stat.offer .num { color: var(--ok); }

/* 筛选 */
.search { background: var(--surface); border-radius: 999rpx; padding: 20rpx 32rpx; font-size: 29rpx; box-shadow: var(--shadow); }
.chips { white-space: nowrap; margin: 0 -32rpx; padding: 0 32rpx; box-sizing: border-box; width: 750rpx; }
.fchip { display: inline-block; border: 1rpx solid var(--line); background: var(--surface); border-radius: 999rpx; padding: 10rpx 26rpx; font-size: 26rpx; color: var(--muted); margin-right: 12rpx; }
.fchip.on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; box-shadow: 0 6rpx 16rpx rgba(49, 86, 211, .17); }
.fchip .n { font-family: var(--mono); font-size: 22rpx; margin-left: 6rpx; opacity: .75; }
.pickwrap { display: flex; flex-wrap: wrap; gap: 12rpx; }
.pickwrap .fchip { margin-right: 0; }

/* 列表 */
.list { display: flex; flex-direction: column; gap: 16rpx; }
.item { display: flex; padding: 26rpx 26rpx 24rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 22rpx; box-shadow: var(--shadow); }
.item-hover { opacity: .75; }
.main { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.name { font-weight: 750; font-size: 32rpx; letter-spacing: .3rpx; line-height: 1.3; }
.ind { font-size: 21rpx; color: var(--muted); background: var(--sunk); border-radius: 8rpx; padding: 2rpx 12rpx; }
.ctype { font-size: 22rpx; color: var(--muted); }
.note { font-size: 25rpx; color: var(--muted); margin-top: 10rpx; line-height: 1.55; word-break: break-all; }
.dates { font-family: var(--mono); font-size: 23rpx; color: var(--muted); margin-top: 12rpx; }
.side { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; margin-left: 20rpx; flex: none; }
.cd { font-family: var(--mono); font-weight: 700; font-size: 27rpx; line-height: 1.3; padding: 6rpx 16rpx; border-radius: 14rpx; color: var(--accent); background: var(--accent-soft); }
.cd:empty { display: none; }
.cd.urgent { color: #fff; background: var(--bad); font-family: inherit; }
.cd.txt, .cd.closed, .cd.soon { font-family: inherit; font-size: 23rpx; font-weight: 500; color: var(--muted); background: var(--sunk); }
.cd.soon { color: var(--warn); background: rgba(217, 130, 11, .12); }
.item.closed .name, .item.closed .dates { color: var(--off); }

/* 状态与核实标记 */
.chip { display: inline-block; font-size: 23rpx; font-weight: 600; padding: 4rpx 18rpx; border-radius: 999rpx; white-space: nowrap; margin-top: 12rpx; }
.chip.none { border: 1rpx dashed var(--off); color: var(--off); font-weight: 500; opacity: .8; }
.s-want { color: var(--slate); background: rgba(75, 100, 121, .14); }
.s-applied { color: var(--accent); background: rgba(31, 79, 209, .12); }
.s-test { color: var(--violet); background: rgba(106, 69, 201, .13); }
.s-interview { color: var(--warn); background: rgba(178, 106, 0, .13); }
.s-offer { color: var(--ok); background: rgba(23, 128, 74, .13); }
.s-rejected, .s-dropped { color: var(--off); background: rgba(134, 144, 155, .14); }
.vb { font-size: 21rpx; font-weight: 600; padding: 2rpx 12rpx; border-radius: 8rpx; line-height: 1.5; background: rgba(75, 100, 121, .1); }
.vb.official { background: rgba(22, 160, 90, .12); }
.vb.single { background: rgba(217, 130, 11, .12); }
.vb.agency { background: rgba(229, 72, 77, .12); }
.vb.official { color: var(--ok); }
.vb.multi { color: var(--slate); }
.vb.single { color: var(--warn); }
.vb.agency { color: var(--bad); }

/* 表单 */
.card { background: var(--surface); border: 1rpx solid var(--line); border-radius: 24rpx; padding: 8rpx 28rpx 28rpx; box-shadow: var(--shadow); }
.field { margin-top: 24rpx; }
.field .label { font-size: 25rpx; color: var(--muted); margin-bottom: 8rpx; display: block; }
.input, .textarea, .picker { background: var(--sunk); border: 1rpx solid transparent; border-radius: 18rpx; padding: 16rpx 22rpx; font-size: 30rpx; color: var(--ink); width: 100%; box-sizing: border-box; min-height: 80rpx; }
.textarea { height: 160rpx; }
.two { display: flex; gap: 20rpx; }
.two > view { flex: 1; min-width: 0; }
.btn { border-radius: 999rpx; font-size: 30rpx; font-weight: 600; padding: 22rpx 0; text-align: center; border: 1rpx solid var(--line); background: var(--surface); color: var(--ink); }
.btn::after { border: none; }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); box-shadow: 0 10rpx 24rpx rgba(49, 86, 211, .19); }
.btn.danger { color: var(--bad); }
.btn[disabled] { opacity: .5; }
.actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
.actions .btn { flex: 1; }
.hint { font-size: 24rpx; color: var(--muted); margin-top: 16rpx; }
.empty { padding: 72rpx 32rpx; text-align: center; color: var(--muted); font-size: 28rpx; }
.alert { margin-top: 20rpx; padding: 22rpx 26rpx; border-radius: 24rpx; background: rgba(229, 72, 77, .08); font-size: 26rpx; }
.alert .t { color: var(--bad); font-weight: 600; }

/* 「含社招 / 博士岗」标签 */
.tag { display: inline-block; font-size: 21rpx; color: var(--violet); background: rgba(122, 90, 248, .12); border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 8rpx; line-height: 1.5; }
.name-row .tag { margin-left: 0; }

.grp { font-size: 21rpx; color: var(--muted); background: var(--sunk); border-radius: 8rpx; padding: 0 8rpx; line-height: 1.5; }
.dlc { font-size: 23rpx; color: var(--warn); margin-top: 4rpx; }

/* 页面顶部的渐变大卡片（首页、AI 挑选） */
.hero { position: relative; overflow: hidden; background: var(--grad); color: #fff; border-radius: 28rpx; padding: 34rpx 32rpx 30rpx; box-shadow: 0 14rpx 34rpx rgba(32, 60, 133, .17); }
.hero::before { content: ''; position: absolute; right: -130rpx; top: -180rpx; width: 420rpx; height: 420rpx; border-radius: 50%; background: rgba(255, 255, 255, .07); }
.hero::after { content: ''; position: absolute; right: 42rpx; bottom: -120rpx; width: 300rpx; height: 220rpx; border-radius: 50%; background: rgba(255, 255, 255, .035); }
.sect-h { font-size: 26rpx; color: var(--muted); font-weight: 600; letter-spacing: 2rpx; margin: 32rpx 8rpx 14rpx; }

/* 微信 button 默认固定宽度，改成撑满容器 */
button.btn { width: auto; }

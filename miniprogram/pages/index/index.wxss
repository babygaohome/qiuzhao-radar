.brand { position: relative; z-index: 1; display: flex; align-items: center; gap: 16rpx; }
.title { font-size: 46rpx; font-weight: 800; letter-spacing: 2rpx; }
.season { font-family: var(--mono); font-size: 22rpx; font-weight: 700; color: #fff; background: rgba(255, 255, 255, .2); border-radius: 999rpx; padding: 2rpx 16rpx; }
.hero .sub { position: relative; z-index: 1; font-size: 23rpx; opacity: .9; margin-top: 8rpx; }
.hstats { position: relative; z-index: 1; display: flex; margin-top: 24rpx; background: rgba(255, 255, 255, .13); border: 1rpx solid rgba(255, 255, 255, .11); border-radius: 18rpx; padding: 18rpx 0 14rpx; }
.hs { flex: 1; text-align: center; }
.hs + .hs { border-left: 1rpx solid rgba(255, 255, 255, .18); }
.hs .num { display: block; font-family: var(--mono); font-size: 37rpx; font-weight: 700; line-height: 1.25; }
.hs .lab { font-size: 21rpx; opacity: .9; }

.qbars { display: flex; gap: 12rpx; margin-top: 20rpx; }
.recent-panel { display: flex; margin-top: 20rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 20rpx; overflow: hidden; }
.recent-cell { flex: 1; min-width: 0; padding: 16rpx 22rpx; }
.recent-cell + .recent-cell { border-left: 1rpx solid var(--line); }
.recent-cell.active { background: var(--accent-soft); }
.recent-name { font-size: 25rpx; font-weight: 600; color: var(--ink); }
.recent-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.recent-number { color: var(--accent); font-family: var(--mono); font-size: 35rpx; font-weight: 700; line-height: 1.35; }
.recent-unit { font-family: inherit; font-size: 22rpx; font-weight: 400; margin-left: 8rpx; color: var(--muted); }
.recent-pending { font-size: 22rpx; color: var(--muted); }
.recent-foot { font-size: 20rpx; color: var(--muted); margin: 8rpx 6rpx 0; }
.shortcuts { margin-top: 12rpx; }
.shortcuts .qbar { padding: 12rpx 18rpx; }
.qbar { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 20rpx; padding: 18rpx 14rpx; box-shadow: var(--shadow); }
.qi { flex: none; width: 56rpx; height: 56rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 800; }
.fresh .qi { color: var(--ok); background: rgba(22, 160, 90, .12); }
.pick .qi { color: var(--warn); background: rgba(217, 130, 11, .13); }
.talk .qi { color: var(--violet); background: rgba(122, 90, 248, .12); }
.qt { flex: 1; min-width: 0; }
.qn { font-family: var(--mono); font-size: 34rpx; font-weight: 700; line-height: 1.2; }
.fresh .qn { color: var(--ok); }
.pick .qn { color: var(--warn); }
.qu { font-family: inherit; font-size: 22rpx; font-weight: 500; margin-left: 4rpx; color: var(--muted); }
.ql { font-size: 22rpx; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.qa { display: none; }

.gap { margin-top: 22rpx; }
.search { display: flex; align-items: center; gap: 14rpx; border: 1rpx solid var(--line); border-radius: 20rpx; box-shadow: none; }
.si { font-size: 36rpx; color: var(--off); line-height: 1; }
.sin { flex: 1; font-size: 29rpx; }
.filters { display: flex; gap: 12rpx; flex-wrap: wrap; }
.fbtn { background: var(--surface); border: 1rpx solid var(--line); border-radius: 999rpx; padding: 10rpx 24rpx; font-size: 25rpx; color: var(--ink); }
.toggles { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 16rpx; }
.tchip { font-size: 24rpx; color: var(--muted); border: 1rpx solid var(--line); background: var(--surface); border-radius: 999rpx; padding: 8rpx 22rpx; }
.tchip.on { color: var(--accent); background: var(--accent-soft); border-color: var(--accent); font-weight: 600; }
.result-head { display: flex; align-items: baseline; justify-content: space-between; margin: 30rpx 4rpx 14rpx; }
.result-title { font-size: 32rpx; font-weight: 750; color: var(--ink); }
.result-count { font-size: 23rpx; color: var(--muted); }
.count { margin: 0 4rpx 16rpx; line-height: 1.55; }
.company-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.company-meta .tag { margin-left: 0; }
.company-meta .vb { flex: none; }
.item .note { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.retry { color: var(--accent); margin-top: 12rpx; }
.foot { text-align: center; font-size: 22rpx; color: var(--muted); margin-top: 28rpx; padding-bottom: 140rpx; }
.fab { position: fixed; right: 32rpx; bottom: calc(32rpx + env(safe-area-inset-bottom)); background: var(--accent); color: var(--accent-ink); font-weight: 700; padding: 20rpx 34rpx; border-radius: 999rpx; box-shadow: 0 12rpx 28rpx rgba(49, 86, 211, .22); font-size: 27rpx; }
.fn { font-family: var(--mono); font-weight: 700; }
.newb { font-size: 20rpx; font-weight: 700; color: #fff; background: var(--bad); border-radius: 8rpx; padding: 0 10rpx; line-height: 1.6; }
.lnk2 { color: var(--accent); font-weight: 600; }
.qn2 { font-size: 28rpx; font-weight: 700; color: var(--violet); line-height: 1.3; }
.vtabs { display: flex; background: var(--sunk); border: 1rpx solid var(--line); border-radius: 18rpx; padding: 6rpx; margin-top: 22rpx; }
.vt { flex: 1; text-align: center; font-size: 26rpx; color: var(--muted); padding: 14rpx 0; border-radius: 14rpx; }
.vt.on { background: var(--surface); color: var(--ink); font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(27, 39, 74, .08); }
.vn { font-family: var(--mono); font-size: 22rpx; margin-left: 8rpx; color: var(--muted); }
.camp { font-size: 22rpx; color: var(--muted); margin: 12rpx 6rpx 0; line-height: 1.55; }
.compact-home.wrap { padding-top: 14rpx; }
.compact-home .hero { padding: 18rpx 24rpx; border-radius: 20rpx; }
.compact-home .title { font-size: 36rpx; }
.compact-home .hero .sub { font-size: 21rpx; margin-top: 2rpx; }
.compact-home .hstats { padding: 8rpx 0 4rpx; margin-top: 10rpx; background: none; border: 0; }
.compact-home .hs .num { display: inline; font-size: 26rpx; margin-right: 6rpx; }
.compact-home .hs .lab { font-size: 19rpx; }
.compact-home .recent-panel { margin-top: 12rpx; border-radius: 16rpx; }
.compact-home .recent-cell { padding: 10rpx 18rpx; }
.compact-home .recent-name { font-size: 23rpx; }
.compact-home .recent-number { font-size: 29rpx; }
.compact-home .recent-pending { font-size: 20rpx; }
.compact-home .shortcuts .qbar { padding: 8rpx 16rpx; border-radius: 14rpx; }
.compact-home .shortcuts .qi { width: 38rpx; height: 38rpx; font-size: 22rpx; border-radius: 12rpx; }
.compact-home .shortcuts .qn, .compact-home .shortcuts .qn2 { font-size: 24rpx; }
.compact-home .shortcuts .ql { font-size: 20rpx; }
.compact-home .vtabs { margin-top: 12rpx; }
.compact-home .vt { padding: 8rpx 0; font-size: 24rpx; }
.compact-home .search { padding: 14rpx 22rpx; }
.compact-home .gap { margin-top: 12rpx; }
.compact-home .fchip { padding: 6rpx 18rpx; font-size: 24rpx; }
.filter-toggle { color: var(--accent); font-size: 24rpx; text-align: right; margin-top: 10rpx; }
.compact-home .result-head { margin-top: 16rpx; margin-bottom: 10rpx; }
.compact-home .result-title { font-size: 28rpx; }
.compact-home .list { gap: 12rpx; }
.compact-home .item { padding: 16rpx 20rpx; border-radius: 18rpx; }
.compact-home .name { font-size: 29rpx; }
.compact-home .name-row { flex-wrap: nowrap; }
.compact-home .name-row .name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.compact-home .name-row .ind { flex: none; }
.compact-home .company-meta { margin-top: 5rpx; }
.compact-home .company-meta { flex-wrap: nowrap; overflow: hidden; max-height: 32rpx; }
.compact-home .company-meta .ctype { font-size: 20rpx; }
.compact-home .item .note { margin-top: 6rpx; font-size: 24rpx; -webkit-line-clamp: 1; }
.compact-home .dates { margin-top: 6rpx; font-size: 21rpx; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.compact-home .cd { font-size: 23rpx; padding: 4rpx 10rpx; }
.compact-home .chip { font-size: 21rpx; margin-top: 8rpx; padding: 3rpx 12rpx; }

/* 今日待办 */
.todo { margin-top: 20rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 20rpx; padding: 18rpx 20rpx 8rpx; box-shadow: var(--shadow); }
.todo-h { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 6rpx; }
.todo-t { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.todo-n { font-size: 22rpx; color: var(--muted); }
.todo-i { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 0; border-top: 1rpx solid var(--line); }
.todo-h + .todo-i { border-top: 0; }
.todo-k { flex: none; font-size: 21rpx; font-weight: 600; border-radius: 8rpx; padding: 2rpx 10rpx; }
.todo-k.deadline { color: var(--warn); background: rgba(217, 130, 11, .13); }
.todo-k.event { color: var(--accent); background: var(--accent-soft); }
.todo-k.follow { color: var(--muted); background: rgba(128, 128, 128, .12); }
.todo-b { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.todo-c { font-size: 26rpx; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.todo-x { font-size: 23rpx; color: var(--muted); margin-top: 2rpx; }
.todo-a { color: var(--muted); font-size: 30rpx; }
.todo-more { font-size: 23rpx; color: var(--accent); padding: 12rpx 0 10rpx; border-top: 1rpx solid var(--line); }

/* 批次：秋招以外的补录 / 春招 / 提前批标出来 */
.btype { font-size: 20rpx; font-weight: 600; color: var(--violet); background: rgba(122, 90, 248, .12); border-radius: 8rpx; padding: 0 10rpx; line-height: 1.6; }
.audit-warn { margin-top: 16rpx; font-size: 23rpx; line-height: 1.5; color: var(--warn); background: rgba(217, 130, 11, .1); border-radius: 14rpx; padding: 12rpx 18rpx; }

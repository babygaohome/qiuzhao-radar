.banner { background: rgba(31, 79, 209, .08); color: var(--accent); border-radius: 18rpx; padding: 18rpx 22rpx; font-size: 26rpx; margin-bottom: 20rpx; }
.intro { margin: 0 4rpx 20rpx; }
.tpls { margin-bottom: 20rpx; }
.polishbar { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.fbtn { border: 1rpx solid var(--line); background: var(--surface); border-radius: 14rpx; padding: 8rpx 18rpx; font-size: 25rpx; color: var(--muted); }
.tpls .pickwrap { margin-top: 10rpx; }
.editor .big { min-height: 360rpx; height: auto; }
.mat { margin-bottom: 20rpx; padding-top: 20rpx; }
.mh { display: flex; align-items: baseline; gap: 12rpx; }
.mt { font-weight: 700; font-size: 30rpx; }
.mc { margin-top: 10rpx; font-size: 27rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.mc.clip { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.ops { display: flex; flex-wrap: wrap; gap: 28rpx; margin-top: 16rpx; font-size: 26rpx; }
.op { color: var(--accent); }
.op.bad { color: var(--bad); }
.op.ai { color: var(--ok); font-weight: 600; }
.result { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: rgba(23, 128, 74, .07); border: 1rpx solid rgba(23, 128, 74, .25); }
.rh { font-weight: 600; font-size: 26rpx; color: var(--ok); }
.rc { margin-top: 8rpx; font-size: 27rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; }

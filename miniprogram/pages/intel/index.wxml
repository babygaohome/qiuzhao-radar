<view class="wrap">
  <view class="hero">
    <view class="title">今日情报</view>
    <view class="sub">AI、半导体与电子产业公开信息</view>
  </view>
  <view wx:if="{{demo}}" class="notice">演示数据 · 非真实资讯</view>
  <view wx:elif="{{!enabled}}" class="notice">情报功能暂未开启</view>
  <scroll-view class="filters" scroll-x>
    <view wx:for="{{filters}}" wx:key="key" class="filter {{category === item.key ? 'on' : ''}}" data-category="{{item.key}}" bindtap="onSelectCategory">{{item.label}}</view>
  </scroll-view>
  <view wx:if="{{loading}}" class="state">正在加载…</view>
  <view wx:elif="{{error}}" class="state">{{error}} <text class="retry" bindtap="onRetry">重试</text></view>
  <view wx:elif="{{items.length === 0}}" class="state">暂时没有可展示的可信资讯。接入受控来源后会在这里显示。</view>
  <view wx:else class="list">
    <view wx:for="{{items}}" wx:key="id" class="item" data-id="{{item.id}}" bindtap="onOpenItem">
      <view class="meta"><text class="tag">{{item.categoryLabel || item.category}}</text><text>{{item.sourceName || '来源未知'}}</text><text>{{item.publishedAt || '发布时间未知'}}</text></view>
      <view class="item-title">{{item.title}}</view>
      <view class="summary">{{item.summaryZh || '暂无摘要'}}</view>
      <view class="summary-status">摘要状态：{{item.summaryStatus || '未知'}}</view>
    </view>
  </view>
</view>

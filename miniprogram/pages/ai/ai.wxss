.intro { margin-bottom: 24rpx; }
.intro .h, .intro .p { position: relative; z-index: 1; }
.h { font-size: 38rpx; font-weight: 800; letter-spacing: .5rpx; }
.p { color: rgba(255, 255, 255, .88); font-size: 25rpx; line-height: 1.6; margin-top: 12rpx; }
.p.warn { color: #FFE08A; font-weight: 600; }
.sum { margin: 28rpx 0 20rpx; background: var(--surface); border: 1rpx solid var(--line); border-left: 7rpx solid var(--accent); border-radius: 20rpx; padding: 22rpx 26rpx; font-size: 27rpx; line-height: 1.6; box-shadow: var(--shadow); }
.sum .small { margin-top: 8rpx; }
.fit { font-size: 22rpx; font-weight: 600; padding: 2rpx 14rpx; border-radius: 999rpx; color: var(--slate); background: rgba(75, 100, 121, .14); }
.fit.hi { color: var(--ok); background: rgba(23, 128, 74, .13); }
.reason { font-size: 25rpx; line-height: 1.6; margin-top: 14rpx; padding: 12rpx 16rpx; border-radius: 12rpx; background: var(--sunk); }
.tip { font-size: 24rpx; line-height: 1.55; color: var(--muted); margin-top: 10rpx; }
.tb { color: var(--accent); font-weight: 600; margin-right: 8rpx; }
.vf { font-size: 21rpx; font-weight: 600; padding: 2rpx 12rpx; border-radius: 999rpx; }
.vf.ok { color: var(--ok); background: rgba(23, 128, 74, .13); }
.vf.mid { color: var(--slate); background: rgba(75, 100, 121, .14); }
.vf.bad { color: var(--bad); background: rgba(198, 47, 42, .12); }
.vf.wait { color: var(--muted); border: 1rpx dashed var(--line); }
.vreason { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.vreason.bad { color: var(--bad); }
.want { margin-top: 12rpx; border: 1rpx solid var(--line); border-radius: 999rpx; padding: 4rpx 22rpx; font-size: 25rpx; color: var(--accent); font-weight: 600; }

.fit.lo { color: var(--bad); background: rgba(198, 47, 42, .1); }
.rank { font-family: var(--mono); font-size: 23rpx; font-weight: 700; color: var(--muted); min-width: 40rpx; }
.proofline { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.name-row .score { margin-left: auto; }
.score { font-size: 24rpx; font-weight: 700; padding: 2rpx 14rpx; border-radius: 999rpx; }
.score.hi { color: #fff; background: var(--ok); }
.score.mid { color: var(--accent); background: rgba(31, 79, 209, .1); }
.score.lo { color: var(--slate); background: rgba(75, 100, 121, .12); }
.rtags { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.rtag { font-size: 21rpx; color: var(--slate); border: 1rpx solid var(--line); border-radius: 8rpx; padding: 0 10rpx; }
.rtag.urgent { color: var(--warn); border-color: var(--warn); }
.rtag.weak { color: var(--muted); border-style: dashed; }
.bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin: 12rpx 0; }
.fchip.sm { font-size: 24rpx; }
.cnt { margin-left: auto; }
.rule-link { margin-top: 10rpx; font-size: 24rpx; color: var(--accent); }
.rule { margin-top: 8rpx; font-size: 24rpx; color: var(--muted); }
.rule view + view { margin-top: 6rpx; }
.more { text-align: center; padding: 28rpx 0 40rpx; font-size: 26rpx; color: var(--accent); }
.more.muted { color: var(--muted); }
.bar .fchip { margin-right: 0; }

/* 底部常驻的开始按钮；页面底部留出同样的高度，免得挡住最后一家 */
.wrap { padding-bottom: 220rpx; }
.fixbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 16rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--line); box-shadow: 0 -8rpx 24rpx rgba(27, 39, 74, .045); }
.fixhint { font-size: 24rpx; color: var(--muted); margin-bottom: 12rpx; text-align: center; }
.fixbtn { margin: 0; }

.qchips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.qc { font-size: 24rpx; color: var(--muted); background: var(--sunk); border-radius: 999rpx; padding: 8rpx 20rpx; }
.qc.on { color: var(--accent-ink); background: var(--accent); font-weight: 600; }
.quick-cats { margin-top: 16rpx; white-space: nowrap; width: 100%; }
.quick-cat { display: inline-block; margin-right: 10rpx; padding: 7rpx 16rpx; border-radius: 10rpx; border: 1rpx solid var(--line); color: var(--muted); background: var(--surface); font-size: 22rpx; }
.quick-cat.on { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); font-weight: 700; }
.quick-selected { margin-top: 10rpx; color: var(--accent); font-size: 22rpx; line-height: 1.5; word-break: break-all; }
.lh { font-size: 21rpx; color: var(--off); margin-left: 8rpx; }

.sec { font-size: 25rpx; font-weight: 700; color: var(--muted); margin: 14rpx 8rpx 2rpx; }
.list .sec:first-child { margin-top: 0; }
.hit { font-size: 25rpx; line-height: 1.55; margin-top: 14rpx; padding: 12rpx 14rpx; border-left: 5rpx solid var(--ok); border-radius: 10rpx; background: rgba(22, 160, 90, .07); }
.hit.rel { border-left-color: var(--slate); background: var(--sunk); }
.hk { font-size: 21rpx; font-weight: 700; padding: 2rpx 10rpx; border-radius: 8rpx; margin-right: 10rpx; }
.hit.direct .hk { color: #fff; background: var(--ok); }
.hit.rel .hk { color: var(--slate); background: rgba(75, 100, 121, .14); }
.calopt2 { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; font-size: 26rpx; flex-wrap: wrap; }
.cbox2 { width: 34rpx; height: 34rpx; border-radius: 10rpx; border: 2rpx solid var(--off); display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #fff; }
.cbox2.on { background: var(--grad); border-color: transparent; }
.elg { font-size: 23rpx; margin-top: 8rpx; color: var(--muted); }
.ek { font-size: 20rpx; font-weight: 700; color: #fff; border-radius: 8rpx; padding: 2rpx 10rpx; margin-right: 10rpx; }
.elg.ok .ek { background: var(--ok); }
.elg.mid .ek { background: var(--off); }
.want.on { color: #fff; background: var(--grad); border-color: transparent; }

.plans { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin: 4rpx 0 12rpx; }
.pl-h { font-size: 24rpx; color: var(--muted); font-weight: 700; margin-right: 4rpx; }
.pl { position: relative; font-size: 25rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 999rpx; padding: 10rpx 24rpx; }
.pl.on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
.pl.add { color: var(--accent); background: var(--accent-soft); box-shadow: none; }
.pl-n { position: absolute; top: -10rpx; right: -6rpx; min-width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center; font-size: 19rpx; font-weight: 700; color: #fff; background: var(--bad); border-radius: 999rpx; padding: 0 6rpx; }
.pl-tip { font-size: 21rpx; color: var(--off); margin-bottom: 12rpx; }
.freshbox { background: var(--surface); border: 1rpx solid var(--line); border-radius: 20rpx; box-shadow: var(--shadow); padding: 18rpx 24rpx; margin-bottom: 20rpx; }
.fb-h { font-size: 25rpx; font-weight: 600; color: var(--ok); }
.fb-i { display: flex; gap: 12rpx; padding: 12rpx 0; border-top: 1rpx solid var(--line); font-size: 25rpx; margin-top: 8rpx; }
.fb-c { font-weight: 700; flex: none; }
.fb-j { color: var(--muted); flex: 1; min-width: 0; }
.fb-more { font-size: 22rpx; color: var(--off); margin-top: 8rpx; }
.evt { font-size: 20rpx; font-weight: 600; border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 10rpx; }
.evt.ok { color: var(--ok); background: rgba(22, 160, 90, .12); }
.evt.mid { color: var(--muted); background: var(--sunk); }
.evln { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.compact-ai .hero { padding: 20rpx 24rpx; border-radius: 20rpx; }
.compact-ai .h { font-size: 32rpx; }
.compact-ai .p { font-size: 23rpx; margin-top: 6rpx; }
.condition-summary { display: flex; justify-content: space-between; gap: 16rpx; padding: 16rpx 20rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 16rpx; font-size: 24rpx; margin-bottom: 18rpx; }
.condition-action { color: var(--accent); white-space: nowrap; flex: none; }
.compact-ai .sum { margin: 18rpx 0 12rpx; padding: 14rpx 18rpx; font-size: 24rpx; }
.compact-ai .bar { gap: 8rpx; margin: 8rpx 0; }
.compact-ai .bar .fchip { padding: 6rpx 16rpx; font-size: 23rpx; }
.compact-ai .list { gap: 12rpx; }
.compact-ai .item { padding: 16rpx 20rpx; border-radius: 18rpx; }
.compact-ai .name { font-size: 29rpx; }
.compact-ai .proofline { margin-top: 5rpx; }
.compact-role { font-size: 25rpx; font-weight: 600; line-height: 1.5; margin-top: 5rpx; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.compact-meta { font-size: 21rpx; color: var(--muted); margin-top: 4rpx; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.evidence-link { font-size: 22rpx; color: var(--accent); margin-top: 7rpx; line-height: 1.5; }
.compact-ai .side { margin-left: 12rpx; }
.compact-ai .cd { font-size: 23rpx; padding: 4rpx 10rpx; }
.compact-ai .want { padding: 4rpx 14rpx; font-size: 23rpx; }

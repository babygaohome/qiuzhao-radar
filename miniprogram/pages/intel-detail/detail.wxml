<view class="wrap">
  <view wx:if="{{demo}}" class="notice">演示数据 · 非真实资讯</view>
  <view wx:if="{{loading}}" class="state">正在加载…</view>
  <view wx:elif="{{error}}" class="state">{{error}}</view>
  <view wx:elif="{{item}}" class="card">
    <view class="meta"><text>{{item.categoryLabel || item.category}}</text><text>{{item.sourceName || '来源未知'}}</text><text>{{item.publishedAt || '发布时间未知'}}</text></view>
    <view class="title">{{item.title}}</view>
    <view class="summary">{{item.summaryZh || '暂无摘要'}}</view>
    <view class="unknown">摘要状态：{{item.summaryStatus || '未知'}}</view>
    <view wx:if="{{item.originalUrl}}" class="link" bindtap="onCopyLink">复制原文链接</view>
    <view wx:else class="unknown">原文链接未知</view>
  </view>
</view>
